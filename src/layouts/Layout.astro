---
import "../styles/global.css";

interface Props {
	title?: string;
}
const { title = "Special endurance calculator" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>

	<header class="border-b border-line bg-paper">
		<div class="mx-auto max-w-5xl w-full px-6 py-5 flex items-center justify-between gap-4">
			<div>
				<p class="font-display text-lg font-semibold tracking-tight">
					<span>KsA</span> calculator
				</p>
				<p class="data text-[11px] text-graphite mt-0.5">
					special endurance coefficient
				</p>
			</div>
		</div>
	</header>

	<body class="grid-paper min-h-screen flex flex-col">
		<slot />
	</body>

	<footer class="border-t border-line bg-paper mt-auto">
		<div class="mx-auto max-w-5xl w-full px-6 py-8 flex items-center justify-between gap-4">
			<p class="data text-[11px] text-graphite">
				Coefficients source: <a target="_blank" href="https://mediatum.ub.tum.de/doc/1233679/1233679.pdf">W. Blödorn (2014)</a>.
			</p>
			<p class="data text-[11px] text-graphite">&copy; Felix Grüb</p>
		</div>
	</footer>
</html>